  "principles": [
    {
      "name": "Price is not value",
      "line": "When price runs far ahead of what a business can earn, the gap eventually closes."
    },
    {
      "name": "The crowd is not evidence",
      "line": "Other people getting rich is a feeling, not a fact about the asset."
    },
    {
      "name": "Set your rules before the test",
      "line": "A margin of safety, decided in calm, protects you from yourself in the frenzy."
    }
  ],
